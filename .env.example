# Copy to .env and adjust as needed. All values have sane defaults in settings.py.

# --- LLM runtime (Ollama) ---
LLM_OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=120

# --- Embeddings ---
# embedding_backend: "ollama" or "sentence_transformers"
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_DIR=./.chroma
CHROMA_COLLECTION=company_corpus

# --- Retrieval ---
RETRIEVER_TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Risk thresholds (0-100) ---
THRESHOLD_FLAG=25
THRESHOLD_BLOCK=50
THRESHOLD_CRITICAL=75

# --- Detection toggles ---
ENABLE_SEMANTIC_DETECTION=false
SEMANTIC_SIMILARITY_THRESHOLD=0.75

# --- Authorization (L3 context guard) ---
# Comma-separated roles allowed to see confidential chunks.
AUTHORIZED_ROLES=admin,security

# --- Paths ---
CORPUS_DIR=./data/corpus
PAYLOAD_DIR=./data/attack_payloads
RESULTS_DIR=./results
AUDIT_LOG_PATH=./results/runs/audit.jsonl
